        "enquiries_area_check": {
          "name": "enquiries_area_check",
          "value": "\"enquiries\".\"area_sqm\" is null or (\"enquiries\".\"area_sqm\" > 0 and \"enquiries\".\"area_sqm\" < 100000)"
