# Copy to .env.local for development, and set the same keys in Vercel.

# Neon Postgres. Use the pooled connection string at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/trinity?sslmode=require
# Direct connection used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/trinity?sslmode=require

# Single admin account. Generate the hash with: npm run hash-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# At least 32 random characters: openssl rand -base64 32
SESSION_SECRET=
# Salt for hashing visitor IPs; never store raw IPs. At least 16 random characters.
IP_HASH_SECRET=

# Resend transactional email.
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=leads@example.com
# Until a domain is verified, use onboarding@resend.dev (delivers only to the Resend account owner).
LEAD_NOTIFICATION_FROM=Trinity Mall <onboarding@resend.dev>

# Public site URL, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://trinity-mall-mvp.vercel.app

# Optional
SEED_DEMO_DATA=false
CRON_SECRET=
